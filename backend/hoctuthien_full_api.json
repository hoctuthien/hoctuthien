{
  "info": {
    "name": "HocTuThien Full API (16 Modules)",
    "description": "Full CRUD API Collection for HocTuThien project based on database.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (using Users table)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["var jsonData = pm.response.json(); if (jsonData.data && jsonData.data.access_token) { pm.collectionVariables.set(\"accessToken\", jsonData.data.access_token); }"] }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}{{apiPrefix}}/auths/login",
            "body": { "mode": "raw", "raw": "{\"email\": \"admin@example.com\", \"password\": \"123456\", \"deviceId\": \"{{device_id}}\"}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        { "name": "Get All Users", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/users" } },
        { "name": "Get One User", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/users/1" } },
        { "name": "Create User", "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/users", "body": { "mode": "raw", "raw": "{\"name\": \"John Doe\", \"email\": \"john@example.com\"}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Mentor Management",
      "item": [
        { "name": "Get All Mentor Profiles", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/mentor-profiles" } },
        { "name": "Create Mentor Profile (Request)", "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/mentor-profiles", "body": { "mode": "raw", "raw": "{\"userId\": \"1\", \"bio\": \"I am a senior dev\", \"jobTitle\": \"Lead Engineer\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Get All Availabilities", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/mentor-availabilities" } },
        { "name": "Create Availability", "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/mentor-availabilities", "body": { "mode": "raw", "raw": "{\"mentorId\": \"1\", \"dayOfWeek\": 1, \"startTime\": \"09:00\", \"endTime\": \"10:00\", \"note\": \"Free time\"}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Course Management",
      "item": [
        { "name": "Get All Categories", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/categories" } },
        { "name": "Get All Courses", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/courses" } },
        { "name": "Create Course", "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/courses", "body": { "mode": "raw", "raw": "{\"mentorId\": \"1\", \"title\": \"NestJS Masterclass\", \"price\": 500000}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Link Course to Category", "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/course-categories", "body": { "mode": "raw", "raw": "{\"courseId\": \"1\", \"categoryId\": \"1\"}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Booking & Reviews",
      "item": [
        { "name": "Create Booking", "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/course-bookings", "body": { "mode": "raw", "raw": "{\"courseId\": \"1\", \"menteeId\": \"1\", \"meetingTime\": \"2024-05-01T10:00:00Z\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Create Course Review", "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/course-reviews", "body": { "mode": "raw", "raw": "{\"courseBookingId\": \"1\", \"courseId\": \"1\", \"reviewerId\": \"1\", \"rating\": 5, \"comment\": \"Great!\"}", "options": { "raw": { "language": "json" } } } } },
        { "name": "Create User Review", "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/user-reviews", "body": { "mode": "raw", "raw": "{\"courseBookingId\": \"1\", \"reviewerId\": \"1\", \"reviewedId\": \"2\", \"rating\": 4}", "options": { "raw": { "language": "json" } } } } }
      ]
    },
    {
      "name": "Payment & Penalty",
      "item": [
        { "name": "Get All Payments", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/payments" } },
        { "name": "Get All Penalty Tickets", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/penalty-tickets" } }
      ]
    },
    {
      "name": "Communication & System",
      "item": [
        { "name": "Get All Conversations", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/conversations" } },
        { "name": "Get Messages (Query Params)", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/messages?conversation_id=1" } },
        { "name": "Get Notifications", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/notifications" } },
        { "name": "Get System Configs", "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/system-configs" } }
      ]
    }
  ],
  "event": [
    { "listen": "prerequest", "script": { "exec": ["if (!pm.collectionVariables.get(\"device_id\")) { pm.collectionVariables.set(\"device_id\", \"device_\" + Math.random().toString(36).substring(7)); }"] } }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5050" },
    { "key": "apiPrefix", "value": "/api/v1" },
    { "key": "device_id", "value": "" },
    { "key": "accessToken", "value": "" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] }
}
