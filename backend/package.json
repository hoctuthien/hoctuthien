  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "dev": "npm run start:dev",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "hygen": "hygen",
    "gen:module": "node scripts/gen-module.js",
    "seed:categories": "ts-node scripts/seed-categories.ts",
    "seed:admin": "ts-node scripts/seed-admin.ts",
    "seed:courses": "ts-node scripts/seed-courses.ts",
    "seed:mentor-courses": "ts-node scripts/seed-custom-mentor-courses.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
