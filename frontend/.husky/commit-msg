#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

PATTERN="^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?: .{1,100}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "❌ Commit message không đúng format Conventional Commits!"
  echo ""
  echo "   Format yêu cầu: <type>(<scope>): <mô tả>"
  echo ""
  echo "   Types hợp lệ:"
  echo "   feat     — Tính năng mới"
  echo "   fix      — Sửa lỗi"
  echo "   docs     — Chỉ thay đổi tài liệu"
  echo "   style    — Format, thiếu dấu chấm phẩy (không đổi logic)"
  echo "   refactor — Tái cấu trúc code"
  echo "   perf     — Cải thiện hiệu suất"
  echo "   test     — Thêm/sửa test"
  echo "   chore    — Build process / auxiliary tools"
  echo "   ci       — CI/CD configuration"
  echo "   build    — Build system / external dependencies"
  echo "   revert   — Revert commit trước"
  echo ""
  echo "   Ví dụ hợp lệ:"
  echo "   feat(booking): add slot selection component"
  echo "   fix(auth): handle expired token redirect"
  echo "   chore: update husky to v9"
  echo ""
  exit 1
fi
